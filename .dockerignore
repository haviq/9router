# VCS
.git
**/.git

# Editor
.vscode
**/.vscode

# Dependencies and build output
# Exclude the *contents*, not the directory: Docker cannot re-include a path
# whose parent directory was excluded, so a bare `node_modules` makes every
# `!node_modules/<pkg>` exception below a no-op — the build context simply has
# no node_modules at all and COPY fails with "not found".
node_modules/*
.next/*
out
build
dist
coverage

# Runtime data and logs
data
logs

# Local env files (inject at runtime via --env-file or -e)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
